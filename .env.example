# 复制为 .env 后填写；.env 已在 .gitignore 中，切勿提交

# DeepSeek：文本推理 / 规划 / 决策
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼：Qwen-VL 视觉判读（OpenAI 兼容模式）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max-latest

# ---- 备选供应商（DeepSeek 充值失败 / 百炼开通卡住时启用）----
# 以下全部走 OpenAI 协议，只改这几行，业务代码一行都不用动。
# 【方案 B】硅基流动 SiliconFlow：一个 Key 同时搞定文本 + 视觉
#   注册 https://cloud.siliconflow.cn/ ，新用户有赠送额度
#   DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
#   DEEPSEEK_MODEL=Qwen/Qwen2.5-72B-Instruct
#   DASHSCOPE_BASE_URL=https://api.siliconflow.cn/v1
#   QWEN_VL_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# 服务
APP_ENV=dev
HOST=0.0.0.0
PORT=8000

# 置信度低于该值 -> 转人工复核
CONFIDENCE_THRESHOLD=0.60

# 强制 mock（不配 Key 时自动开启）
# MOCK_MODE=1

# 向量检索：默认 0（关键词检索，无需联网）。
# 设为 1 会首次下载约 80MB 的 embedding 模型，网差会卡，谨慎开启。
RAG_ENABLED=0

# ---- 登录鉴权 ----
# 1=所有 /api 需要 Bearer token（WS 用 ?token=xxx），0=关闭
AUTH_ENABLED=1
ACCESS_TOKEN_TTL_MIN=120
REFRESH_TOKEN_TTL_DAYS=7
# 默认账号（首次建库时自动写入）：admin/admin123、inspector/inspector123、reviewer/reviewer123

# ---- v7: 媒体与对外地址 ----
# 图片绝对地址基址；留空则用请求来源。跨网/反代建议显式写，例 http://192.168.1.10:8000
PUBLIC_BASE_URL=
MEDIA_RETENTION_DAYS=90

# ---- v8: 定时清理（0=关闭）----
CLEANUP_INTERVAL_HOURS=24
CLEANUP_DAYS_MEMORIES=180
CLEANUP_DAYS_TRACES=30
